{
  "entities": {
    "Staff": {
      "title": "Staff",
      "description": "Medical technologist and support staff records for Blood Bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "thaiName": { "type": "string", "maxLength": 100 },
        "englishName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["technologist", "assistant", "part_time"] },
        "position": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "enum": ["lab", "donor", "both"] },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "role": { "type": "string", "enum": ["super_admin", "sub_admin", "staff"] },
        "password": { "type": "string", "maxLength": 100 },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "thaiName", "englishName", "category", "position", "room", "isActive"]
    },
    "ShiftType": {
      "title": "ShiftType",
      "description": "Shift type codes and compensation rates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 4, "minLength": 1 },
        "name": { "type": "string", "maxLength": 100 },
        "period": { "type": "string", "enum": ["morning", "afternoon", "night", "other"] },
        "timeRange": { "type": "string", "maxLength": 50 },
        "rate": { "type": "number" },
        "isOt": { "type": "boolean" },
        "color": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "code", "name", "period", "timeRange", "rate"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Monthly room duty assignments grid",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "string", "enum": ["lab", "donor"] },
        "yearMonth": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "assignments": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "roomId", "yearMonth", "assignments"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Blood Bank duty configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "hospitalName": { "type": "string", "maxLength": 200 },
        "departmentName": { "type": "string", "maxLength": 200 },
        "adminName": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Realtime automatic and manual backup snapshots of schedules, staff, and shifts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string" },
        "yearMonth": { "type": "string" },
        "triggerType": { "type": "string" },
        "description": { "type": "string" },
        "updatedBy": { "type": "string" },
        "dutyCount": { "type": "number" },
        "labAssignments": { "type": "object" },
        "donorAssignments": { "type": "object" }
      },
      "required": ["id", "timestamp", "yearMonth", "triggerType"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": { "$ref": "Staff" },
      "description": "Staff roster for Blood Bank"
    },
    "/shiftTypes/{shiftTypeId}": {
      "schema": { "$ref": "ShiftType" },
      "description": "Duty shift codes and rates"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "Schedule" },
      "description": "Monthly duty schedules"
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "BackupSnapshot" },
      "description": "Realtime backup snapshots"
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "SystemSetting" },
      "description": "General settings"
    }
  }
}
